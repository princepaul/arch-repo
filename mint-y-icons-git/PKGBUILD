# Contributor: twa022 <twa022 at gmail dot com>

pkgname=mint-y-icons
pkgver=1.9.7.r0.g1030774c1
pkgrel=1
pkgdesc='New icons from Linux Mint inspired by the Moka icon set'
arch=(any)
url='https://github.com/linuxmint/mint-y-icons'
license=('GPL-3.0-or-later')

makedepends=(git)

optdepends=(
  'mint-x-icons: Mint-Y inherits missing icons from Mint-X'
)

options=('!debug')

source=('git+https://github.com/linuxmint/mint-y-icons.git')
b2sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  git describe --long \
    | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

package() {
  cd "${srcdir}/${pkgname}"
  cp -a usr "${pkgdir}"
}
