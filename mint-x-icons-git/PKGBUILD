# Maintainer: Santiago Burgos <santiago.burgos1089@gmail.com>

pkgname=mint-x-icons
pkgver=1.8.0.r0.gff9791a3
pkgrel=1
pkgdesc='A mint/metal icon theme inspired by Clearlooks, Elementary and Faenza'
arch=(any)
url='https://github.com/linuxmint/mint-x-icons'
license=('GPL-3.0-or-later')

options=('!debug')

source=('git+https://github.com/linuxmint/mint-x-icons.git')
b2sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  git describe --long \
    | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

package() {
  cd "${srcdir}/${pkgname}"
  cp -a usr "${pkgdir}"
}
