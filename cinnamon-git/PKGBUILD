pkgver() {
    cd "${srcdir}"/${pkgname}
    git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd ${srcdir}/${pkgname}

  # Add Traditional button layout option
  # https://github.com/linuxmint/cinnamon/pull/13326
  git apply -3 ../cinnamon-menu-button.patch

  # Use wheel group instread of sudo (taken from Fedora)
  patch -Np1 -i ../cinnamon-set-wheel.patch

  # Cinnamon has no upstream backgrounds, use GNOME backgrounds instead
  # https://github.com/linuxmint/cinnamon/issues/3575#issuecomment-374887122
  sed -i 's|/usr/share/cinnamon-background-properties|/usr/share/gnome-background-properties|' \
    files/usr/share/cinnamon/cinnamon-settings/modules/cs_backgrounds.py

  # Fix Clutter 1.46+ API changes (set_allocation and allocate_align_fill now require flags)
  for f in $(grep -rl "clutter_actor_set_allocation" src/ 2>/dev/null); do
    sed -i 's/clutter_actor_set_allocation (\([^)]*\));/clutter_actor_set_allocation (\1, CLUTTER_ALLOCATION_NONE);/g' "$f"
  done
  for f in $(grep -rl "clutter_actor_allocate_align_fill" src/ 2>/dev/null); do
    perl -0777 -pi -e 's/(clutter_actor_allocate_align_fill\s*\(.*?)(\);)/$1, CLUTTER_ALLOCATION_NONE$2/gs' "$f"
  done

  # Upstream no longer hides valid themes via THEMES_BLACKLIST (dead sed removed)

}

build() {
  arch-meson $pkgname build \
    --libexecdir=lib/$pkgname \
    -D docs=true
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" 30_org.archlinux.cinnamon.gschema.override

  # Replace the theme with your custom version
  cp -f "$srcdir/cinnamon.css" "$pkgdir/usr/share/cinnamon/theme/cinnamon.css"
  cp -f "$srcdir/toggle-on.svg" "$pkgdir/usr/share/cinnamon/theme/toggle-on.svg"
  cp -f "$srcdir/toggle-off.svg" "$pkgdir/usr/share/cinnamon/theme/toggle-off.svg"

  
  # Verify the replacement
  if cmp "$srcdir/cinnamon.css" "$pkgdir/usr/share/cinnamon/theme/cinnamon.css" >/dev/null; then
      echo "✓ Custom cinnamon.css successfully installed"
  else
      echo "✗ Failed to replace cinnamon.css"
      exit 1
  fi
}
