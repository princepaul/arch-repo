pkgbase=nemo-extensions
pkgname=(
  nemo-audio-tab
  nemo-compare
  #nemo-dropbox
  nemo-emblems
  nemo-fileroller
  nemo-image-converter
  #nemo-media-columns
  #nemo-pastebin
  #nemo-preview
  nemo-python
  #nemo-repairer
  #nemo-seahorse
  #nemo-share
  nemo-terminal
)
pkgver=6.8.0.r3.g7063301
pkgrel=1
pkgdesc="Various extensions for Nemo"
arch=(x86_64)
license=(GPL-2.0-or-later)
url="https://github.com/linuxmint/nemo-extensions"
depends=(nemo)
_python_deps=(python-gobject)
makedepends=(
  git
  gobject-introspection
  intltool
  meson
  nemo
  python-setuptools
  python-gobject
)
options=(!emptydirs strip !debug)
source=("git+https://github.com/linuxmint/nemo-extensions.git")
b2sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgbase}"
  git describe --long --tags --match '[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${srcdir}/${pkgbase}"
  rm -rf */debian # Fix build with newer setuptools
}

build() {
  cd "${srcdir}/${pkgbase}"

  for _dir in "${pkgname[@]}"; do
    pushd "$_dir"
    if [[ -f meson.build ]]; then
      arch-meson . build \
        --libexecdir="lib/$_dir"
      meson compile -C build
    fi
    if [[ -f setup.py ]]; then
      python setup.py build
    fi
    popd
  done
}

package_nemo-audio-tab() {
  pkgdesc="View audio tag information in Nemo properties tab"
  license=(GPL-3.0-only)
  depends=(
    glib2
    gtk3
    nemo
    nemo-python
    python
    python-gobject
    python-mutagen
  )
  optdepends=('cinnamon-translations: i18n')

  cd "${srcdir}/${pkgbase}/${pkgname}"
  python setup.py install --prefix=/usr --root="${pkgdir}" --skip-build --optimize=1
}

package_nemo-compare() {
  pkgdesc="Context menu comparison extension for Nemo file manager"
  license=(GPL-3.0-or-later)
  depends=(
    glib2
    gtk3
    meld
    nemo
    nemo-python
    python
    python-gobject
  )
  optdepends=(
    'meld: Install at least one file comparison program'
    'kompare: Additional comparison options'
    'fldiff: Additional comparison options'
    'diffuse: Alternate comparison backend'
    'kdiff3: Alternate comparison backend'
  )

  cd "${srcdir}/${pkgbase}/${pkgname}"
  python setup.py install --prefix=/usr --root="${pkgdir}" --skip-build --optimize=1
}

