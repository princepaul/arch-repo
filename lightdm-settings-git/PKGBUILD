# Maintainer: Sam Burgos <santiago.burgos1089@gmail.com>

_pkgname=lightdm-settings
pkgname=${_pkgname}
pkgver=2.1.1.r0.gce623a9
pkgrel=1
pkgdesc='A configuration tool for the LightDM display manager – git'
arch=('any')
url="https://github.com/linuxmint/${_pkgname}"
license=('GPL-3.0-only')
depends=(
    hicolor-icon-theme
    lightdm-slick-greeter
    polkit
    python-gobject
    python-setproctitle
    python-xapp
)
makedepends=(
    desktop-file-utils
    gettext
)
optdepends=('lightdm-guest: Enable guest session options')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${_pkgname}"
    git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${srcdir}/${_pkgname}"
  make
}

package() {
  cd "${srcdir}/${_pkgname}"
  cp -r usr "$pkgdir"
}
