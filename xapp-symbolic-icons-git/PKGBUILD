# Maintainer: Prince Paul <prince dot paul dot k @ gmail dot com>

pkgname=xapp-symbolic-icons
pkgver=1.1.1.r0.g6ff2e6b
pkgrel=1
pkgdesc='Symbolic icons for XApp project (git version)'
arch=(any)
url='https://github.com/xapp-project/xapp-symbolic-icons'
license=('GPL-2.0-only')

makedepends=(git meson)

provides=("${pkgname%}")
conflicts=("${pkgname%-git}")

options=('!debug')

source=('git+https://github.com/xapp-project/xapp-symbolic-icons.git')
b2sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname%-git}"
  git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${srcdir}/${pkgname%-git}"
  arch-meson . build
  meson compile -C build
}

package() {
  cd "${srcdir}/${pkgname%-git}"
  DESTDIR="${pkgdir}" meson install -C build
}
