# .gitignore for Arch Linux packaging project

# Ignore directories created by build scripts
/arch-repo/
/oldbuilds/

# Ignore files and directories generated by makepkg within package folders.
# These patterns will apply recursively to all subdirectories.
pkg/
src/
/nemo/

# Ignore built package archives.
*.pkg.tar.zst

# Ignore log files that might be generated during builds.
*.log

# Ignore common editor and IDE configuration files.
.vscode/
.idea/

# Ignore swap and backup files from editors like Vim/Emacs.
*.swp
*.swo
*~
